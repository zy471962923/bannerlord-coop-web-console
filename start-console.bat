@echo off
chcp 65001 >nul
title Bannerlord Coop Web Console
rem %~dp0 is already the console folder -- do not append a subfolder
cd /d "%~dp0"

rem Usage:  start-console.bat [port]
rem   (none)    listen on 0.0.0.0:7788  -- every NIC, anyone who can reach this PC
rem   7790      custom port -- handy for a second read-only panel
rem
rem There used to be a separate start-console-lan.bat. It is gone: this script
rem always binds 0.0.0.0 now, so LAN / ZeroTier / the public NIC all work the
rem same way, with no source filtering.
rem
rem Want it locked down instead? Do NOT edit this file -- open the console's
rem Config tab and change the bind address (written to config.json):
rem   0.0.0.0    everyone (default)
rem   127.0.0.1  this machine only
rem   auto       loopback + private subnets (LAN / ZeroTier, no public NIC)
rem
rem WHERE THE PORT COMES FROM (highest first):
rem   env COOP_CONSOLE_PORT > --port > config.json > 7788
rem
rem This script deliberately does NOT set COOP_CONSOLE_HOST / COOP_CONSOLE_PORT --
rem setting them pinned the values at the top of that list, so whatever you saved
rem in the Config tab was silently ignored.
rem
rem KEEP THIS FILE ASCII-ONLY + CRLF. cmd.exe misparses UTF-8 text inside
rem if(...) blocks, and an LF-only file makes the window close instantly.
rem (Tried Chinese messages here once -- the multibyte text got split and cmd
rem  ran half of it as a command. Keep it ASCII, put Chinese in INSTALL.txt.)

set "PORTARG="
if not "%~1"=="" set "PORTARG=--port %~1"

echo [start] %PORTARG%
echo [note] port / bind address are read from config.json when defined there.
echo        edit them in the console: Config tab -^> save -^> restart.

rem ---- locate node.exe, in order of preference ----
rem 1) node.exe right next to this script (the shipped package: nothing to install)
rem 2) runtime\node.exe (bundled layout)
rem 3) "node" anywhere on PATH (a normal Node.js installation)
set "NODE="
if exist "%~dp0node.exe" set "NODE=%~dp0node.exe"
if defined NODE goto HAVENODE
if exist "%~dp0runtime\node.exe" set "NODE=%~dp0runtime\node.exe"
if defined NODE goto HAVENODE
where node >nul 2>nul
if errorlevel 1 goto NONODE
set "NODE=node"

:HAVENODE
echo [node]  %NODE%
echo.
"%NODE%" server.js %PORTARG%
echo.
echo Console exited. The game server it started has stopped too.
pause
exit /b 0

:NONODE
echo.
echo [ERROR] node.exe not found.
echo.
echo   Put node.exe NEXT TO start-console.bat in this folder.
echo   It ships inside the release zip -- if it is missing, unzip the whole
echo   folder again instead of pulling single files out of the archive.
echo.
echo   Or install Node.js 18+ from https://nodejs.org and make sure
echo   the "node" command works -- either way is fine.
echo.
if exist "%~dp0INSTALL.txt" start "" notepad "%~dp0INSTALL.txt"
pause
exit /b 1
